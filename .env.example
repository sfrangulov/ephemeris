# ephemeris environment — copy to .env.local and fill in real values.
# Project already created: "ephemeris" (ref hvmgpohpvlmejzhyaqng).
# Keys live in Project Settings → API Keys. Use the NEW keys (publishable /
# secret), not the legacy anon / service_role JWT keys.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://hvmgpohpvlmejzhyaqng.supabase.co
# Publishable key (sb_publishable_...) — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — SERVER ONLY, authorizes as service_role.
# Never commit, never ship to the browser. Copy from the dashboard.
SUPABASE_SECRET_KEY=

# Shared secret guarding the daily snapshot cron route.
# Generate with `openssl rand -hex 32`. Also set as a Vercel env var.
CRON_SECRET=

# GitHub token for star counts + stargazer backfill (5000 req/h vs 60 anon).
# A fine-grained or classic PAT with public read is enough. `gh auth token`
# works locally. Optional — without it stars are skipped.
GITHUB_TOKEN=

# Supabase auth.users.id (UUID) of the platform operator. Gates the manual
# sync FAB and /api/sync workflow dispatch. Use user.id (immutable) instead
# of user_metadata.user_name (mutable via supabase.auth.updateUser).
OWNER_USER_ID=

# Origin used by client-rendered share snippets (copy-badge markdown).
# Falls back to request host header when unset.
NEXT_PUBLIC_SITE_URL=

# DeepSeek API key for the grounded-phrasing layer (lib/phrase.ts). Cheap
# inference; AI only PHRASES real metrics, pre-generated + cached in sync.
# Read by @ai-sdk/deepseek. Optional — without it phrase() ships the
# deterministic template fallback.
DEEPSEEK_API_KEY=
