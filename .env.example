# ephemeris environment — copy to .env.local and fill in real values.
# Create the Supabase project at https://supabase.com/dashboard, then grab
# these from Project Settings → API.

# Supabase project URL (e.g. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Never commit, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret guarding the daily snapshot cron route. Generate a random one,
# e.g. `openssl rand -hex 32`. Also set as a Vercel env var.
CRON_SECRET=
