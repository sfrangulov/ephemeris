# ephemeris environment — copy to .env.local and fill in real values.
# Project already created: "ephemeris" (ref hvmgpohpvlmejzhyaqng).
# Keys live in Project Settings → API Keys. Use the NEW keys (publishable /
# secret), not the legacy anon / service_role JWT keys.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://hvmgpohpvlmejzhyaqng.supabase.co
# Publishable key (sb_publishable_...) — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — SERVER ONLY, authorizes as service_role.
# Never commit, never ship to the browser. Copy from the dashboard.
SUPABASE_SECRET_KEY=

# Shared secret guarding the daily snapshot cron route.
# Generate with `openssl rand -hex 32`. Also set as a Vercel env var.
CRON_SECRET=
